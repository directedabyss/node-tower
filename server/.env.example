# Copy to server/.env and fill in ONLY the source you use. server/.env is gitignored; never commit it.
# Missing or failing settings always fall back to demo data. Secrets are never printed.

# demo | file | sheet | clickup | trello | notion | webhook
FEED_SOURCE=demo

# Optional server settings
FEED_PORT=8788
FEED_INTERVAL_MS=2000
FEED_POLL_MS=10000

# file: local JSON or CSV (absolute path, or relative to the repo root)
FEED_FILE=examples/tasks.example.json

# sheet: Google Sheet published to the web as CSV (no auth)
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?output=csv

# clickup: personal API token + list id (GET requests only)
CLICKUP_TOKEN=replace_me
CLICKUP_LIST_ID=replace_me

# trello: API key + token + board id (GET requests only)
TRELLO_KEY=replace_me
TRELLO_TOKEN=replace_me
TRELLO_BOARD_ID=replace_me

# notion: internal integration token + database id (read-only query)
NOTION_TOKEN=replace_me
NOTION_DATABASE_ID=replace_me
NOTION_OWNER_PROP=Owner
NOTION_STATUS_PROP=Status
NOTION_TITLE_PROP=
NOTION_DUE_PROP=Due

# webhook: optional shared secret, sent as header X-Node-Tower-Secret
WEBHOOK_SECRET=replace_me
